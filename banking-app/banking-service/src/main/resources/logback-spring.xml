<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <!-- Inject dd.trace_id / dd.span_id so logs correlate with APM traces -->
            <includeMdcKeyName>dd.trace_id</includeMdcKeyName>
            <includeMdcKeyName>dd.span_id</includeMdcKeyName>
            <includeMdcKeyName>dd.service</includeMdcKeyName>
            <includeMdcKeyName>dd.env</includeMdcKeyName>
            <includeMdcKeyName>dd.version</includeMdcKeyName>
            <customFields>{"service":"banking-app"}</customFields>
        </encoder>
    </appender>

    <!-- Plain text — read by error-ingestion-agent and the UI dashboard -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/banking-app/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>/var/log/banking-app/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- JSON — read by the Datadog agent; immediateFlush ensures no buffering lag -->
    <appender name="DATADOG_JSON" class="ch.qos.logback.core.FileAppender">
        <file>/var/log/banking-app/banking-app.json.log</file>
        <immediateFlush>true</immediateFlush>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- error.stack is Datadog's standard attribute for stack traces -->
            <fieldNames>
                <stackTrace>error.stack</stackTrace>
            </fieldNames>
            <customFields>{"service":"banking-app","ddsource":"java","env":"dev"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="DATADOG_JSON"/>
    </root>

    <logger name="com.demo.banking" level="DEBUG"/>
</configuration>
