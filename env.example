# ─────────────────────────────────────────────────────────────────────────────
# env.example — copy to .env and fill in your values
#
#   cp env.example .env        (Mac/Linux)
#   copy env.example .env      (Windows)
#
# .env is in .gitignore — never commit it.
#
# NOTE: API keys (Anthropic, Gemini, GitHub/GitLab, Datadog) are NOT configured
# here. Configure them through the Apollo UI after first login:
#   → Integrations → GitHub/GitLab (Claude API key + repo token)
#   → Integrations → Datadog (Datadog API/App key)
#   → Integrations → Ingestion Agent (Gemini API key + log paths)
#
# Only infrastructure settings belong in this file.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (required) ───────────────────────────────────────────────────────
# MySQL runs on the HOST (not in Docker). host.docker.internal resolves to the
# host from inside containers (works on Mac, Windows, and Linux with extra_hosts).
# Create the DB first: CREATE DATABASE rca_db CHARACTER SET utf8mb4;
#
# DB_PASSWORD   — MySQL root password; used by docker-compose to build DATABASE_URL
# DATABASE_URL  — used when running agents locally (outside Docker); keep localhost here.
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/rca_db


# ── RCA Agent defaults ────────────────────────────────────────────────────────
# These are startup defaults only. The UI Settings tab can override most of them
# at runtime without a container restart.
MODEL=claude-haiku-4-5-20251001
MAX_REACT_ITERATIONS=20
OBSERVABILITY_ADAPTER=local
CICD_ADAPTER=mock


# ── Ingestion Agent startup defaults ─────────────────────────────────────────
# These set the initial mode and file paths before an org is configured in the UI.
# Once you create/select an org, the agent reads its config from the database.
MODE=db
LOG_FILE_PATHS=/var/log/banking-app/app.log
SERVICE_NAME=banking-app
ENVIRONMENT=production


# ── Datadog log shipper (dd-agent container) ──────────────────────────────────
# Only needed if you want the Datadog Agent sidecar to ship logs to Datadog.
# Leave blank if you don't use Datadog — the rest of the stack starts fine without it.
# DD_API_KEY=
# DD_SITE=us5.datadoghq.com
