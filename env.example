# ─────────────────────────────────────────────────────────────────────────────
# env.example — local Docker Compose secrets
#
# Copy to `env` and fill in your values:
#   cp env.example env
#
# `env` is in .gitignore — never commit it.
# This file is used by docker-compose.yml via `env_file: env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Datadog ───────────────────────────────────────────────────────────────────
# Required for the dd-agent container and Datadog-mode log querying in the UIs.
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here

# Datadog site — must match your account registration
# Options: datadoghq.com | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com
DD_SITE=datadoghq.com

# ── Database (host MySQL — shared by rca-agent and ingestion-agent) ──────────
# MySQL runs on the host, not in Docker.  host.docker.internal resolves to the
# host from inside containers.  Change user/password if you used different creds.
DATABASE_URL=mysql+pymysql://rca:Rca@12345@host.docker.internal:3306/rca_db

# ── RCA Agent ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
GITHUB_PAT=ghp_your_token_here

# ── Error Ingestion Agent ────────────────────────────────────────────────────
# Required for error classification (Gemini) and Datadog-poll mode.
GEMINI_API_KEY=AIza_your_key_here
