# ─────────────────────────────────────────────────────────────────────────────
# env.example — copy to .env and fill in your values
#
#   cp env.example .env        (Mac/Linux)
#   copy env.example .env      (Windows)
#
# .env is in .gitignore — never commit it.
# docker-compose.yml reads this via:  env_file: .env
# ─────────────────────────────────────────────────────────────────────────────


# ── Anthropic (required — RCA agent uses Claude for root cause analysis) ──────
# Get your key: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here


# ── Google Gemini (required — ingestion agent uses Gemini to classify errors) ─
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_key_here


# ── GitLab (required — RCA agent fetches code, diffs, and commits from GitLab) ─
# Create a Personal Access Token: GitLab → User Settings → Access Tokens
# Required scopes: read_api + read_repository
# Note: the env var is named GITHUB_PAT for backwards compatibility; it accepts a GitLab token (glpat-...)
GITHUB_PAT=glpat-your_token_here
GITHUB_ORG=apollo
GITLAB_URL=http://your-gitlab-host


# ── Datadog (optional — only needed for Datadog ingestion mode) ───────────────
# API key:  https://app.datadoghq.com/organization-settings/api-keys
# App key:  https://app.datadoghq.com/organization-settings/application-keys
# App key scopes needed: logs_read_data, logs_read_index_data
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here

# Datadog site — must match your account region
# Options: datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com
DD_SITE=us5.datadoghq.com


# ── Database ──────────────────────────────────────────────────────────────────
# MySQL runs on the HOST (not in Docker). host.docker.internal resolves to the
# host from inside containers (works on Mac, Windows, and Linux with extra_hosts).
# Create the DB first: CREATE DATABASE rca_db CHARACTER SET utf8mb4;
#
# DB_PASSWORD   — MySQL root password; used by docker-compose to build DATABASE_URL
#                 with host.docker.internal for container → host connectivity.
# DATABASE_URL  — used when running agents locally (outside Docker); keep localhost here.
DB_PASSWORD=your_mysql_password
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/rca_db


# ── RCA Agent ─────────────────────────────────────────────────────────────────
# These can also be changed at runtime via the Settings tab in Apollo (no restart needed).
MODEL=claude-haiku-4-5-20251001
MAX_REACT_ITERATIONS=20
OBSERVABILITY_ADAPTER=local
CICD_ADAPTER=mock
RCA_POLL_ENABLED=false
RCA_POLL_INTERVAL_SECONDS=30


# ── Error Ingestion Agent ─────────────────────────────────────────────────────
# These are overridden by docker-compose.yml for Docker deployments.
# Only set them here for local (non-Docker) runs of the ingestion agent.
MODE=db
LOG_FILE_PATHS=/var/log/banking-app/app.log
SERVICE_NAME=banking-app
ENVIRONMENT=production
